# =========================================================================
# KONFIGURASI DATABASE & OBJECT STORAGE CLOUDFLARE R2
# =========================================================================
# Dapatkan nilai ini dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens:
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=cpg-storage

# Opsional: Jika Anda mengaktifkan Public R2.dev URL atau Custom Domain di Cloudflare R2
# Contoh: https://pub-xxxxxxxxxxxx.r2.dev atau https://media.cindara.co.id
# Jika dikosongkan, aplikasi otomatis menggunakan internal proxy streaming (/api/r2-file?key=...)
CLOUDFLARE_R2_PUBLIC_URL=

# =========================================================================
# GOOGLE DRIVE & GOOGLE APPS SCRIPT (Opsional - Cadangan Database Spreadsheet)
# =========================================================================
GOOGLE_DRIVE_SCRIPT_URL=
GOOGLE_DRIVE_TTB_FOLDER_ID=1Hd6FsgWiALq1jJyRvh8auY0FJGE9h5tf
